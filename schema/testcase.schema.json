{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LUNAR testcase import",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "steps"],
  "$defs": {
    "imageReference": {"type": "string", "pattern": "^[^/\\\\]+\\.png$"}
  },
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "labels": {"type": "array", "items": {"type": "string"}},
    "components": {"type": "array", "items": {"type": "string"}},
    "custom_fields": {"type": "object"},
    "screenshots": {"type": "array", "items": {"$ref": "#/$defs/imageReference"}, "uniqueItems": true},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "action", "expected_result"],
        "properties": {
          "system": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "data": {"type": "string"},
          "expected_result": {"type": "string", "minLength": 1},
          "tester": {"type": "string"},
          "attachments": {"type": "array", "items": {"$ref": "#/$defs/imageReference"}, "uniqueItems": true},
          "screenshots": {"type": "array", "items": {"$ref": "#/$defs/imageReference"}, "uniqueItems": true}
        }
      }
    }
  }
}
